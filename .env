# Database Configuration
# Local SQLite default for instant zero-config testing:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://user:password@localhost:5432/kirana_sathi?schema=public"

# Authentication
JWT_SECRET="kirana-sathi-secure-jwt-secret-key-32chars-min-2026"

# App & Store Identity
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Kirana Sathi"
NEXT_PUBLIC_STORE_NAME_BN="কিরানা সাথী"
NEXT_PUBLIC_STORE_TAGLINE="সব কিছু এক ছাদের নিচে"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_WHATSAPP_PHONE="919876543210"

# Payments (Razorpay Sandbox / Test Mode)
# Leave as dummy to use interactive built-in Sandbox Simulation
RAZORPAY_KEY_ID="rzp_test_kirana_sandbox"
RAZORPAY_KEY_SECRET="rzp_test_secret_sandbox"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_kirana_sandbox"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_kirana"

# Demo Mode (Simulates Razorpay payment popups & SMS/WhatsApp without external credentials)
DEMO_MODE="true"
